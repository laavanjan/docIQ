# Environment for `docker compose`. Copy to `.env` and fill in secrets.
# (Per-service config lives in backend/.env.example for non-Docker dev.)

# ---- LLM providers ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PRIMARY=anthropic
LLM_FALLBACK_ENABLED=true

# ---- Auth ----
JWT_SECRET=change-me-please-use-a-long-random-string

# ---- Extraction ----
YOLO_ENABLED=true
YOLO_MODEL_PATH=yolov8n.pt

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Frontend (build-time) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
