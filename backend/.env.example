# ============================================================================
# Document Analysis Platform — backend configuration
# Copy to `.env` and fill in real values. See docs/CONFIGURATION.md for details.
# ============================================================================

# ---- App ----
ENVIRONMENT=development            # development | production | test
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000 # comma-separated list

# ---- Database (PostgreSQL + pgvector) ----
# Local dev (Postgres on host / via `docker compose up -d postgres`):
DATABASE_URL=postgresql+psycopg://docanalysis:docanalysis@localhost:5432/docanalysis

# ---- Auth / JWT ----
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional API keys for programmatic (X-API-Key) access, comma-separated. Empty disables it.
API_KEYS=

# ---- LLM providers ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PRIMARY=anthropic              # anthropic | openai
LLM_FALLBACK_ENABLED=true          # fall back to the other provider on failure
LLM_MAX_TOKENS=2048
# Temperature is omitted from API calls by default (several newer Claude/OpenAI models reject a
# custom value). Only set this if your chosen model supports it.
# LLM_TEMPERATURE=0.2

# ---- Embeddings (local fastembed / ONNX) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- RAG ----
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Document extraction ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
# Only needed for the OCR method when NOT running in Docker:
TESSERACT_CMD=                     # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=                      # e.g. C:\poppler\Library\bin
YOLO_ENABLED=true                  # run YOLO layout detection before Tesseract
YOLO_MODEL_PATH=yolov8n.pt         # path to layout-detection weights
OCR_DPI=200
VISION_DPI=150

# ---- Logging ----
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_DIR=./logs
LOG_JSON=false                     # true => machine-readable JSON logs
